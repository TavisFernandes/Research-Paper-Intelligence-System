# Copy to .env (never commit .env). All values are optional unless marked.

# --- Vector store -----------------------------------------------------------
# auto: Redis Stack when reachable, else a *reported* non-persistent in-memory store
# redis: require Redis Stack (RediSearch)   memory: in-process only (tests/demo)
VECTOR_STORE_BACKEND=auto
REDIS_URL=redis://localhost:6379/0
REDIS_INDEX=paper_chunks
REDIS_INDEX_ALGORITHM=HNSW

# --- Embeddings (dense) -------------------------------------------------------
# Defaults to the local fine-tuned BGE-M3 checkpoint when present, otherwise BAAI/bge-m3.
# To override, set EMBEDDING_MODEL=BAAI/bge-m3 or a local Hugging Face model directory.
EMBEDDING_DEVICE=auto
# If the model cannot be loaded, fall back to NON-semantic hashing vectors (reported in /api/health).
ALLOW_HASHING_FALLBACK=true

# --- Retrieval -----------------------------------------------------------------
RETRIEVAL_MODE=hybrid
DEFAULT_TOP_K=8
MIN_DENSE_SCORE=0.35
MIN_LEXICAL_COVERAGE=0.5

# --- Chat answers: Gemini API first; local Ollama fallback if Gemini is unavailable
# Create a Gemini API key and put it in the ignored .env file. This setting affects chat only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_QA_MAX_TOKENS=512

# --- Other LLM features: OpenAI-compatible endpoint (used by paper comparisons)
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.5-plus
LLM_TIMEOUT_SECONDS=30
LLM_QA_MAX_TOKENS=320
LLM_QA_TIMEOUT_SECONDS=30

# Local fallback when the cloud key is missing or the API is unreachable.
# Prefer a smaller local model (e.g. qwen3:4b) so answers finish reliably offline.
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_API_KEY=ollama
LLM_FALLBACK_MODEL=qwen3:4b
LLM_FALLBACK_TIMEOUT_SECONDS=90
LLM_FALLBACK_MAX_TOKENS=400

# --- Summarisation ----------------------------------------------------------------
ENABLE_LED=false
LED_MODEL=allenai/led-base-16384
# LED_STATE_DICT_PATH=Model_Training/LED_Model/led_base_scientific_summarizer.pth
# The team notebook trained with 4096-token inputs; match it when using that checkpoint:
# LED_MAX_INPUT_TOKENS=4096
# LED_WINDOW_TOKENS=3500

# --- Ingestion ----------------------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
MAX_UPLOAD_BYTES=20971520
OCR_ENABLED=true
INDEX_REFERENCES=false
# PAPER_STORAGE_DIR=./backend/data

# --- API ----------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
