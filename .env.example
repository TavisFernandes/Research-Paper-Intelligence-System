# Copy to .env (never commit .env). All values are optional unless marked.

# --- Vector store -----------------------------------------------------------
# auto: Redis Stack when reachable, else a *reported* non-persistent in-memory store
# redis: require Redis Stack (RediSearch)   memory: in-process only (tests/demo)
VECTOR_STORE_BACKEND=auto
REDIS_URL=redis://localhost:6379/0
REDIS_INDEX=paper_chunks
REDIS_INDEX_ALGORITHM=HNSW

# --- Embeddings (dense) -------------------------------------------------------
# Hugging Face id or a local fine-tuned checkpoint directory.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
# If the model cannot be loaded, fall back to NON-semantic hashing vectors (reported in /api/health).
ALLOW_HASHING_FALLBACK=true

# --- Retrieval -----------------------------------------------------------------
RETRIEVAL_MODE=hybrid
DEFAULT_TOP_K=8
MIN_DENSE_SCORE=0.35
MIN_LEXICAL_COVERAGE=0.5

# --- Answer generation: any OpenAI-compatible endpoint -----------------------------
# Examples: Together AI https://api.together.xyz/v1 | HF router https://router.huggingface.co/v1 | local vLLM http://localhost:8001/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.5-9B
LLM_TIMEOUT_SECONDS=60

# --- Summarisation ----------------------------------------------------------------
ENABLE_LED=false
LED_MODEL=allenai/led-base-16384
# LED_STATE_DICT_PATH=Model_Training/LED_Model/led_base_scientific_summarizer.pth
# The team notebook trained with 4096-token inputs; match it when using that checkpoint:
# LED_MAX_INPUT_TOKENS=4096
# LED_WINDOW_TOKENS=3500

# --- Ingestion ----------------------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
MAX_UPLOAD_BYTES=20971520
OCR_ENABLED=true
INDEX_REFERENCES=false
# PAPER_STORAGE_DIR=./backend/data

# --- API ----------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
